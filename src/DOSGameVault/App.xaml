<Application x:Class="DOSGameVault.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DOSGameVault">
<Application.Resources><FontFamily x:Key="AppFont">Segoe UI, Microsoft YaHei</FontFamily><local:CoverImageConverter x:Key="CoverImage"/><local:BoolIndexConverter x:Key="BoolIndex"/>
 <SolidColorBrush x:Key="Accent" Color="#356BFA"/><SolidColorBrush x:Key="Muted" Color="#9298B2"/><SolidColorBrush x:Key="Line" Color="#2C2F48"/>
 <BooleanToVisibilityConverter x:Key="Bool"/>
 <Style TargetType="ScrollViewer"><Setter Property="local:SmoothScrolling.Enabled" Value="True"/></Style>
 <Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/></Style>
 <Style TargetType="Control"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#E6E8F1"/></Style>
 <Style TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="local:UiMotion.Interactive" Value="True"/><Setter Property="Background" Value="#24263D"/><Setter Property="Foreground" Value="#CBD0E4"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303550"/><Setter TargetName="Surface" Property="BorderBrush" Value="Transparent"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="Transparent"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="Transparent"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="#202139"/><Setter Property="Foreground" Value="#E6E8F1"/><Setter Property="CaretBrush" Value="#356BFA"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="10,9"/><Setter Property="SelectionBrush" Value="#2D4484"/></Style>
 <Style TargetType="CheckBox"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="#CDD0E0"/><Setter Property="Margin" Value="0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/><Border x:Name="Track" local:UiMotion.SwitchState="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Grid.Column="1" Background="#45485F" CornerRadius="11" Width="36" Height="20" VerticalAlignment="Center"><Ellipse x:Name="Knob" Fill="#F4FAFF" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Thumb" x:Key="ScrollThumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#424867" CornerRadius="3" Margin="2,1"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="#141627"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="#D0D4E7"/><Setter Property="Background" Value="#22243B"/><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="OptionSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#303550"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#303550"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="#233358"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="OptionSurface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="#D0D4E7"/><Setter Property="MinHeight" Value="33"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#22243B" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,3" Foreground="#A3AECE"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,4,28,4" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup local:UiMotion.Dropdown="True" x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" HorizontalOffset="-12" VerticalOffset="-4" AllowsTransparency="True" Focusable="False"><Grid><Border Margin="12,8,12,18" Background="#22243B" CornerRadius="12" MinWidth="{TemplateBinding ActualWidth}"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45" RenderingBias="Performance"/></Border.Effect><local:RoundedBorder Background="#22243B" CornerRadius="12" Padding="4"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></local:RoundedBorder></Border></Grid></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="#1A1C30"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
 <Style x:Key="CardHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#EDF0FA"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
 <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><UniformGrid IsItemsHost="True" Rows="1" Margin="0,0,0,20"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TabItem"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="#BBC2DC"/><Setter Property="Padding" Value="18,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="#1C1E32" BorderBrush="Transparent" BorderThickness="0,0,0,1" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#293250"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="Transparent"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#F0F3FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#2D304B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Slider"><Setter Property="Height" Value="20"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#356BFA" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#356BFA" Stroke="#356BFA" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#343A59" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="ModalButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#282F47"/><Setter Property="Foreground" Value="#F0F3FF"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ModalButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModalButtonSurface" Property="Background" Value="#35405C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ModalButtonSurface" Property="Background" Value="#20283C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModalButtonSurface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Application.Resources>
</Application>















