<UserControl x:Class="DOSGameVault.GameCoverPlaceholder"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:DOSGameVault">
 <Grid ClipToBounds="True">
  <Border Background="{Binding CoverColor}"/>
  <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#B0000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <TextBlock Text="{Binding Category}" FontFamily="Consolas, Microsoft YaHei" FontSize="70" FontWeight="Bold" Foreground="#18FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-12,24"/>
  <StackPanel Margin="15"><TextBlock Text="{local:Loc Key=T6cb915804c7c}" FontFamily="Consolas, Microsoft YaHei" Foreground="#8AA0B4" FontSize="9"/><Border Height="1" Background="Transparent" Margin="0,9,0,0"/></StackPanel>
  <TextBlock FontSize="23" Text="{Binding DisplayTitle}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12,28" Foreground="#EDF0FA"/>
  <StackPanel VerticalAlignment="Bottom" Margin="15"><TextBlock Text="{Binding FolderName}" FontFamily="Consolas, Microsoft YaHei" FontSize="11" Foreground="#A7C2DB"/><TextBlock Text="{local:Translate Path=Genre}" FontSize="9" Foreground="#7A8D9F" Margin="0,4,0,0"/></StackPanel>
 </Grid>
</UserControl>
