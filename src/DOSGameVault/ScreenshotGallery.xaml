<UserControl x:Class="DOSGameVault.ScreenshotGallery" x:Name="Gallery"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:DOSGameVault">
 <StackPanel Margin="0,0,0,14" IsEnabled="{Binding HasSelection}">
  <local:RoundedBorder CornerRadius="14">
  <Grid x:Name="PreviewArea" Background="#101221" SizeChanged="PreviewSizeChanged" MouseEnter="CoverPointerChanged" MouseLeave="CoverPointerChanged" ClipToBounds="True">
   <Button x:Name="PreviewButton" Click="OpenPreview" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip="{local:Loc Key=ImagesZoom}">
    <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></ControlTemplate></Button.Template>
    <Grid ClipToBounds="True" local:CoverHover.Enabled="True"><local:GameCoverPlaceholder x:Name="Placeholder" DataContext="{Binding SelectedGame}"/><Image x:Name="Preview" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
   </Button>
   <Button x:Name="PreviousButton" Click="Previous" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="28" Height="36" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="{local:Loc Key=ImagesPrevious}"><Path Data="M 12,1 L 1,13 L 12,25" Width="8" Height="16" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
   <Button x:Name="NextButton" Click="Next" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="36" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="{local:Loc Key=ImagesNext}"><Path Data="M 1,1 L 12,13 L 1,25" Width="8" Height="16" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
   <TextBlock x:Name="Counter" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#CC101221" Padding="8,3"/>
  </Grid>
  </local:RoundedBorder>
  <ScrollViewer x:Name="DetailThumbnails" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
   <StackPanel x:Name="ThumbnailStrip" Orientation="Horizontal"/>
  </ScrollViewer>
  <Border x:Name="DropArea" Visibility="Collapsed" Margin="0,14,0,0" AllowDrop="True" DragOver="ImagesDragOver" DragLeave="ImagesDragLeave" Drop="ImagesDrop" Background="Transparent" CornerRadius="12" Padding="0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="DropTarget" Margin="0,0,12,0" VerticalAlignment="Top">
     <Rectangle Stroke="#526080" StrokeThickness="1" StrokeDashArray="6,4" RadiusX="14" RadiusY="14" IsHitTestVisible="False"/>
     <Button x:Name="AddImagesTile" Click="Upload" Background="Transparent" BorderThickness="0" Padding="12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Loc Key=ImagesAdd}">
      <StackPanel>
       <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,8"><Ellipse Fill="#20273C"/><Path Data="M 0,10 L 20,10 M 10,0 L 10,20" Width="16" Height="16" Stretch="Uniform" Stroke="#A6CFFF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
       <TextBlock Text="{local:Loc Key=ImagesDrop}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Foreground="#DCE2F2" TextWrapping="Wrap"/>
       <TextBlock Text="{local:Loc Key=ImagesFormats}" FontSize="11" TextAlignment="Center" Foreground="#9198B4" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
     </Button>
    </Grid>
    <WrapPanel x:Name="UploadTiles" Grid.Column="1" SizeChanged="UploadTilesSizeChanged" VerticalAlignment="Top"/>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{local:Loc Key=ImagesCoverHint}" Foreground="#9198B4" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </Grid>
  </Border>
 </StackPanel>
</UserControl>
